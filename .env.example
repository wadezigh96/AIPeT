# Privy
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# x402 / Multi-chain
# EVM recipient (Base + BNB + Robinhood Chain)
PAY_TO_ADDRESS=0xfceafec082f9e8b17cdb51f33c3d5c9759a25e03

# Optional dedicated wallet for animal charity (defaults to PAY_TO_ADDRESS)
CHARITY_PAY_TO_ADDRESS=

# Solana recipient
PAY_TO_SOLANA=GN3GD3JGqE1B1H7SrA8ncu3YQgVgT8qRVYvKzE8pscvn

# Facilitator (optional)
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532

# Prices (USD)
CHAT_PRICE_USD=0.01
DONATE_PRICE_USD=0.50
CONTRIBUTE_PRICE_USD=0.25
CHARITY_PRICE_USD=1.00

# Enforce HTTP 402 on paid routes
ENABLE_X402_PAYWALL=false

# AI Provider (optional — falls back to mock)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# App URL (required for Farcaster Mini App)
NEXT_PUBLIC_APP_URL=http://localhost:3000
