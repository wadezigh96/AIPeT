# Privy
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# x402 / EVM
# Recipient of all x402 payments (pembuat / creator)
PAY_TO_ADDRESS=0xfceafec082f9e8b17cdb51f33c3d5c9759a25e03

# Network: eip155:84532 = Base Sepolia (testnet), eip155:8453 = Base Mainnet
X402_NETWORK=eip155:84532

# Facilitator URL (public Coinbase one for testnet)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Prices (USD)
CHAT_PRICE_USD=0.01
DONATE_PRICE_USD=0.50
CONTRIBUTE_PRICE_USD=0.25

# AI Provider (optional - falls back to simple mock)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
